  },
  {
    "id": "pg_frag_grenades",
    "name": "Frag Grenades",
    "type": "Gear",
    "effect": "Expend a charge for the following effect:<ul><li><b>Frag Grenade</b> (Grenade, Range 5, Blast 1): Affected characters must succeed on an Agility save or take 2 Explosive damage.</li></ul>",
