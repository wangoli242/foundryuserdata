                            style="color:#9b59b6; font-weight:bold;">{{localize "CINEMATIC.Trigger.PF2eCriticalSuccess"}}</option>
                        {{/if}}
                        {{/unless}}
                        {{/if}}

                        {{#if ../isMidiActive}}
                        <option value="midiAttack" {{#if (eq this.trigger "midiAttack" )}}selected{{/if}}
                            style="color:#ff9f43; font-weight:bold;">{{localize "CINEMATIC.Trigger.Type.MidiAttack"}}</option>
                        <option value="midiDamage" {{#if (eq this.trigger "midiDamage" )}}selected{{/if}}
                            style="color:#ff9f43; font-weight:bold;">{{localize "CINEMATIC.Trigger.Type.MidiDamage"}}</option>
                        <option value="midiCrit" {{#if (eq this.trigger "midiCrit" )}}selected{{/if}}
                            style="color:#ff6b6b; font-weight:bold;">{{localize "CINEMATIC.Trigger.Type.MidiCritical"}}</option>
                        {{/if}}
