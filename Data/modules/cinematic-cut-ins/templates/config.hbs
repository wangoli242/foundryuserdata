                        <i class="fas fa-times"></i>
                    </button>
                </div>
                {{/each}}

                {{#unless triggers.turnEnd.length}}
                <div style="text-align:center; color:#666; font-size:0.8em; padding:5px; border:1px dashed #444;">
                    {{localize "CINEMATIC.Trigger.Empty.TurnEnd"}}
                </div>
                {{/unless}}
            </div>

            <hr style="border-color:#444; margin: 15px 0;">

            <h4 style="margin: 0 0 10px 0; border-bottom: 1px solid #444; color: #ccc; font-size: 0.9em;">
