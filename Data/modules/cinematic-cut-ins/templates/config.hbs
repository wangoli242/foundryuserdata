                    style="display: grid; grid-template-columns: 1fr 1.5fr 1fr 1fr 30px; gap: 5px; align-items: center; background: rgba(255,255,255,0.05); padding: 5px; border: 1px solid #444; border-radius: 4px;">
                    <select name="triggers.conditions.{{@index}}.mode" style="width: 100%; font-size:0.85em;">
                        <option value="apply" {{#if (eq this.mode "apply" )}}selected{{/if}}>{{localize "CINEMATIC.Trigger.Mode.Apply"}}</option>
                        <option value="remove" {{#if (eq this.mode "remove" )}}selected{{/if}}>{{localize "CINEMATIC.Trigger.Mode.Remove"}}</option>
                    </select>

                    <div style="display:flex; flex-direction:column; gap:2px;">
                        <input type="text" name="triggers.conditions.{{@index}}.conditionId" value="{{this.conditionId}}"
                            class="condition-id-input" placeholder="{{localize 'CINEMATIC.Trigger.Placeholder.Condition'}}"
                            style="width:100%; font-family:monospace; background:rgba(0,0,0,0.3); border:1px solid #444; color:#fff;">
                        <select class="condition-id-helper"
                            style="font-size:0.8em; height:20px; padding:0 5px; color:#aaa; background:#222; border:1px solid #333;">
                            <option value="">▼ {{localize "CINEMATIC.Trigger.SelectCondition"}}</option>
                            {{#each ../conditionOptions}}
                            <option value="{{this.id}}">{{this.label}} ({{this.id}})</option>
                            {{/each}}
                        </select>
                    </div>

                    <select name="triggers.conditions.{{@index}}.presetId" style="width:100%; font-size:0.85em;">
                        <option value="" class="group-fallback-empty-option">{{../groupTriggerSelectLabel}}</option>
                        {{#each ../triggerPresetOptions}}
                        <option value="{{this.id}}" {{#if (eq ../this.presetId this.id)}}selected{{/if}}>
                            {{this.name}}
                        </option>
                        {{/each}}
                    </select>

                    <select name="triggers.conditions.{{@index}}.macroId" style="width:100%; font-size:0.8em; color:#b8860b; background:rgba(0,0,0,0.3); border:1px solid #555;" title="{{localize 'CINEMATIC.Trigger.MacroTooltip'}}">
                        <option value="">{{localize "CINEMATIC.Trigger.NoMacro"}}</option>
                        {{#each ../macroList}}
                        <option value="{{this.id}}" {{#if (eq ../this.macroId this.id)}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>

                    <button type="button" data-action="remove-condition-trigger" data-index="{{@index}}"
                        style="height: 28px; background: #442222; color: #ff6b6b; border: 1px solid #ff4444; padding:0; display:flex; align-items:center; justify-content:center;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                {{/each}}

                {{#unless triggers.conditions.length}}
                <div style="text-align:center; color:#666; padding:10px; border:1px dashed #444; border-radius:5px;">
                    {{localize "CINEMATIC.Trigger.Empty.Conditions"}}
                </div>
                {{/unless}}
            </div>

            <!-- 리소스 트리거 리스트 -->
            <div class="form-group" style="margin-bottom: 5px;">
                <label style="font-weight:bold; color:#fff;">{{localize "CINEMATIC.Trigger.ResourceTriggers"}}</label>
                <button type="button" data-action="add-resource-trigger"
                    style="width:auto; padding:2px 8px; font-size:0.8em; color:white;">
                    <i class="fas fa-plus"></i> {{localize "CINEMATIC.Trigger.BtnAdd"}}
                </button>
            </div>

            <!-- 글로벌 모드 전용: 참조 액터 선택기 -->
            {{#if isGlobalMode}}
            <div
                style="background:rgba(0,0,0,0.3); padding:5px; border-radius:4px; margin-bottom:10px; border:1px solid #444;">
                <label style="font-size:0.8em; color:#aaa; display:block; margin-bottom:3px;">
                    <i class="fas fa-search"></i> {{localize "CINEMATIC.Global.Label.ScanAttributes"}}
                </label>
                <select id="reference-actor-select" style="width:100%; font-family:'Teko'; font-size:1.1em;">
                    <option value="">{{localize "CINEMATIC.Global.SelectReference"}}</option>
                    {{#each allActors}}
                    <option value="{{this.id}}" {{#if (eq ../referenceActorId this.id)}}selected{{/if}}>
                        {{this.name}}
                    </option>
                    {{/each}}
                </select>
                <p style="font-size:0.7em; color:#666; margin:3px 0 0 0;">
                    {{localize "CINEMATIC.Global.Hint.ScanAttributes"}}
                </p>
            </div>
            {{/if}}

            <div class="resource-trigger-list" style="display:flex; flex-direction:column; gap:10px;">
                {{#each triggers.resources}}
                <div class="trigger-card"
                    style="background:rgba(255,255,255,0.05); padding:10px; border-radius:5px; border-left:3px solid #e61c34;">

                    <!-- 1줄: 속성 선택 + 삭제 버튼 -->
                    <div style="display:flex; gap:5px; margin-bottom:5px; align-items: flex-start;">
                        <div style="flex:1; display:flex; flex-direction:column; gap:2px;">
                            <!-- flex:initial 추가하여 높이 100px 강제 적용 해제 -->
                            <label style="font-size:0.7em; color:#aaa; flex:initial; width:auto; height:auto;">
                                {{localize "CINEMATIC.Trigger.Label.Path"}}
                            </label>

                            <!-- 1. 실제 데이터가 저장될 입력창 -->
                            <input type="text" name="triggers.resources.{{@index}}.path" value="{{this.path}}"
                                class="resource-path-input" placeholder="system.attributes.hp.value"
                                style="width:100%; font-family:monospace; background:rgba(0,0,0,0.3); border:1px solid #444; color:#fff;">

                            <!-- 2. 빠른 입력을 돕는 헬퍼 셀렉트박스 -->
                            <select class="resource-path-helper"
                                style="font-size:0.8em; height:20px; padding:0 5px; color:#aaa; background:#222; border:1px solid #333;">
                                <option value="">▼ {{localize "CINEMATIC.Trigger.SelectHelper"}}</option>
                                {{#each ../availableAttributes}}
                                <option value="{{this.path}}">{{this.label}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <button type="button" data-action="remove-resource-trigger" data-index="{{@index}}"
                            style="flex:0 0 25px; height:25px; margin-top:15px; color:#ff6b6b; border:none; background:rgba(0,0,0,0.3); border-radius:4px; cursor:pointer;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>

                    <!-- 2줄: 조건 모드 + 임계값 + 프리셋 -->
                    <div style="display:flex; gap:5px; align-items:flex-end;">

                        <!-- 1. [신규] 발동 모드 선택 (이하/이상) -->
                        <div style="flex:0 0 110px; display:flex; flex-direction:column; gap:2px;">
                            <label style="font-size:0.7em; color:#aaa; flex:initial; width:auto; height:auto;">
                                {{localize "CINEMATIC.Trigger.TriggerMode"}}
                            </label>
                            <select name="triggers.resources.{{@index}}.mode" style="width:100%; font-size:0.85em;">
                                <option value="decrease" {{#if (eq this.mode "decrease" )}}selected{{/if}}>
                                    {{localize "CINEMATIC.Trigger.Mode.Decrease"}}
                                </option>
                                <option value="increase" {{#if (eq this.mode "increase" )}}selected{{/if}}>
                                    {{localize "CINEMATIC.Trigger.Mode.Increase"}}
                                </option>
                            </select>
                        </div>

                        <!-- 2. 리소스 트리거 수치 -->
                        <div style="flex:0 0 130px; display:flex; flex-direction:column; gap:2px;">
                            <label style="font-size:0.7em; color:#aaa; flex:initial; width:auto; height:auto;">
                                {{localize "CINEMATIC.Trigger.Threshold"}}
                            </label>
                            <div style="display:flex; gap:2px;">
                                <input type="number" name="triggers.resources.{{@index}}.threshold"
                                    value="{{this.threshold}}" min="0" style="flex:1; text-align:center;">

                                <select name="triggers.resources.{{@index}}.type"
                                    style="flex:0 0 45px; padding:0; font-size:0.8em;" title="Unit">
                                    <option value="percent" {{#if (eq this.type "percent" )}}selected{{/if}}>%</option>
                                    <option value="value" {{#if (eq this.type "value" )}}selected{{/if}}>№</option>
                                </select>
                            </div>
                        </div>

                        <!-- 3. Max 경로/값 (선택) - WoD5e 등 특수 시스템용 -->
                        <div style="flex:0 0 130px; display:flex; flex-direction:column; gap:2px;">
                            <label style="font-size:0.7em; color:#aaa; flex:initial; width:auto; height:auto;">
                                Max (Path or №)
                            </label>
                            <input type="text" name="triggers.resources.{{@index}}.customMax"
                                value="{{this.customMax}}" placeholder="auto"
                                title="Leave empty for auto-detect. Enter path (system.health.max) or number (10)"
                                style="width:100%; font-size:0.8em; font-family:monospace; background:rgba(0,0,0,0.3); border:1px solid #555; color:#ccc;">
                        </div>

                        <div style="flex:1; display:flex; flex-direction:column; gap:2px;">
                            <label style="font-size:0.7em; color:#aaa; flex:initial; width:auto; height:auto;">
                                {{localize "CINEMATIC.Trigger.Preset"}}
                            </label>

                            <select name="triggers.resources.{{@index}}.presetId" style="width:100%;">
                                <option value="" class="group-fallback-empty-option">{{../groupTriggerSelectLabel}}</option>
                                {{#each ../triggerPresetOptions}}
                                <option value="{{this.id}}" {{#if (eq ../this.presetId this.id)}}selected{{/if}}>
                                    {{this.name}}
                                </option>
                                {{/each}}
                            </select>
                        </div>

                        <div style="flex:0 0 110px; display:flex; flex-direction:column; gap:2px;">
                            <label style="font-size:0.7em; color:#b8860b; flex:initial; width:auto; height:auto;">
                                {{localize "CINEMATIC.Trigger.MacroLabel"}}
                            </label>
                            <select name="triggers.resources.{{@index}}.macroId" style="width:100%; font-size:0.85em; color:#b8860b; background:rgba(0,0,0,0.3); border:1px solid #555;" title="{{localize 'CINEMATIC.Trigger.MacroTooltip'}}">
                                <option value="">{{localize "CINEMATIC.Trigger.NoMacro"}}</option>
                                {{#each ../macroList}}
                                <option value="{{this.id}}" {{#if (eq ../this.macroId this.id)}}selected{{/if}}>{{this.name}}</option>
                                {{/each}}
                            </select>
                        </div>
                    </div>
                </div>
                {{/each}}

                {{#unless triggers.resources.length}}
                <div style="text-align:center; color:#666; padding:10px; border:1px dashed #444; border-radius:5px;">
                    {{localize "CINEMATIC.Trigger.NoTriggers"}}
                </div>
                {{/unless}}
            </div>

        </div>
    </div>

    <div class="preview-panel">
        <h3>{{localize "CINEMATIC.Config.LivePreview"}}</h3>
        <div class="preview-container">
            <div id="preview-stage" class="cinematic-wrapper">
                <!-- 1. 커스텀 배경 태그 추가 -->
                <div class="cinematic-custom-bg"></div>

                <div class="cinematic-custom-layers"></div>
                <div class="cinematic-bg-layer">
                    <div class="cinematic-paint"></div>
                </div>
                <div class="cinematic-deco-line"></div>

                <!-- 추가 장식 레이어 (CSS 제어) -->
                <div class="cinematic-extra-deco">
<div class="deco-elem elem-1"></div>
  <div class="deco-elem elem-2"></div>
  <div class="deco-elem elem-3"></div>
  <div class="deco-elem elem-4"></div>
  <div class="deco-elem elem-5"></div>
  <div class="deco-elem elem-6"></div>
  <div class="deco-elem elem-7"></div>
  <div class="deco-elem elem-8"></div>
                </div>

                <!-- SVG 기반 테두리 시스템 -->
                <div class="cinematic-border-layer">
                    <svg class="cinematic-border-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="preview-royal-gold-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#bf953f" />
                                <stop offset="25%" stop-color="#fcf6ba" />
                                <stop offset="50%" stop-color="#b38728" />
                                <stop offset="75%" stop-color="#fbf5b7" />
                                <stop offset="100%" stop-color="#aa771c" />
                            </linearGradient>
                        </defs>
                        <!-- Royal 테마용 육각형 -->
                        <polygon class="border-poly-royal" points="0,50 5,0 95,0 100,50 95,100 5,100" vector-effect="non-scaling-stroke"/>
                    </svg>
                </div>

                <div class="char-mask">
                    <img class="cinematic-character" src="{{img}}" />
                </div>

                <!-- 2. 커스텀 오버레이 태그 추가 -->
                <div class="cinematic-custom-overlay"></div>

                <div class="cinematic-content">
                    <div class="cinematic-text-main">{{text}}</div>
                    <div class="cinematic-text-sub">{{subText}}</div>
                </div>

                <div class="cinematic-screen-filter"></div>
            </div>
        </div>
        <p class="hint">{{localize "CINEMATIC.Config.PreviewHint"}}</p>

        <div class="form-footer" style="display: flex; gap: 5px;">
            
            <button type="button" data-action="toggle-pause" style="background: #333; flex: 0 0 15%;" 
                title="Pause/Resume Preview">
                <i class="fas fa-pause"></i>
            </button>

            <button type="button" data-action="reset" style="background: #555; flex: 0 0 15%;"
                title="{{localize 'CINEMATIC.Config.BtnReset'}}">
                <i class="fas fa-undo"></i>
            </button>
            
            <button type="button" data-action="test-play" style="background: #e67e22; flex: 0 0 30%; font-size: 0.9em;">
                <i class="fas fa-play"></i> {{localize "CINEMATIC.Config.BtnTest"}}
            </button>
            <button type="button" data-action="save" style="background: #e61c34; flex: 1;">
                <i class="fas fa-save"></i>
                {{#if isActorMode}}
                {{localize "CINEMATIC.Config.BtnSaveActiveConfig"}}
                {{else}}
                {{localize "CINEMATIC.Config.BtnSaveConfig"}}
                {{/if}}
            </button>
        </div>
    </div>
</div>
