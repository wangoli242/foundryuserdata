                        placeholder="{{localize 'CINEMATIC.Trigger.Placeholder.Rounds'}}" 
                        title="{{localize 'CINEMATIC.Trigger.Title.RoundInput'}}"
                        style="width: 80px; text-align: center; font-size: 0.85em; background:rgba(0,0,0,0.3); color:#fff; border:1px solid #555;">

                    <select name="triggers.turnStart.{{@index}}.presetId" style="flex:1; font-size:0.85em;">
                        <option value="" class="group-fallback-empty-option">{{groupTriggerSelectLabel}}</option>
