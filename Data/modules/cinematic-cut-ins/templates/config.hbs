<div class="cinematic-config-wrapper">
    <div class="config-panel">

        <!-- 탭 네비게이션 -->
        <nav class="cinematic-tabs-nav">
            <a class="item active" data-tab="preset"><i class="fas fa-list"></i> {{localize "CINEMATIC.Config.Tab.Preset"}}</a>
            <a class="item" data-tab="visual"><i class="fas fa-image"></i> {{localize "CINEMATIC.Config.Tab.Visual"}}</a>
            <a class="item" data-tab="text"><i class="fas fa-font"></i> {{localize "CINEMATIC.Config.Tab.Text"}}</a>
            <a class="item" data-tab="effects"><i class="fas fa-magic"></i> {{localize "CINEMATIC.Config.Tab.Effects"}}</a>
            <a class="item" data-tab="layers"><i class="fas fa-layer-group"></i> {{localize "CINEMATIC.Config.Tab.Layers"}}</a>
            <a class="item" data-tab="triggers"><i class="fas fa-bolt"></i> {{localize "CINEMATIC.Config.Tab.Triggers"}}</a>
        </nav>

        <!-- ============================================ -->
        <!-- TAB: PRESET -->
        <!-- ============================================ -->
        <div class="tab-content active" data-tab="preset">
            <div class="preset-manager"
                style="background: rgba(0,0,0,0.2); padding: 10px; border-radius: 5px; margin-bottom: 15px; border: 1px solid #444;">
                <h3 style="margin-top: 0; border: none; font-size: 1.2em;">
                    <i class="fas fa-list"></i> {{localize "CINEMATIC.Config.Presets"}}
                </h3>

                {{#if isActorMode}}
                <div class="form-group">
                    <div class="form-fields" style="gap: 5px;">
                        <select id="preset-select" style="flex: 1;">
                            <option value="">{{localize "CINEMATIC.Config.SelectPreset"}}</option>
                            {{#each presets}}
                            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                        <button type="button" data-action="load-preset" title="{{localize 'CINEMATIC.Config.BtnCopyToActive'}}"
                            style="flex: 0 0 30px;">
                            <i class="fas fa-upload"></i>
                        </button>
                        <button type="button" data-action="delete-preset"
                            title="{{localize 'CINEMATIC.Config.BtnDelete'}}" style="flex: 0 0 30px; color: #ff6b6b;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                {{/if}}

                <!-- [B] Global Presets (공용 스타일 - 모든 모드에서 표시하도록 수정) -->
                <div class="form-group" style="margin-top: 5px; padding-top: 5px; border-top: 1px dashed #555;">
                    <div class="form-fields" style="gap: 5px;">
                        <select id="global-preset-select" style="flex: 1; background: #2a2a2a; color: #aaa;">
                            <option value="">-- Global Styles (World) --</option>
                            {{#each globalPresets}}
                            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                        <!-- 불러오기 버튼 -->
                        <button type="button" data-action="load-global" title="{{localize 'CINEMATIC.Config.BtnCopyGlobalToActive'}}"
                            style="flex: 0 0 30px; color: #4ecdc4;">
                            <i class="fas fa-globe-americas"></i>
                        </button>
                    </div>
                </div>

                <!-- [C] Save Section (저장 섹션) -->
                <div class="form-group" style="margin-top: 10px;">
                    <div class="form-fields" style="gap: 5px;">
                        
                        <!-- value="{{presetName}}" 속성 (기존 이름을 미리 채움) -->
                        <input type="text" id="preset-name" value="{{presetName}}"
                            placeholder="{{localize 'CINEMATIC.Config.Placeholder.PresetName'}}" style="flex: 1;">

                        {{#if isActorMode}}
                        <!-- [Case A] 액터 모드: 개인 저장 + 글로벌 내보내기 -->
                        <button type="button" data-action="save-preset" style="width: auto;"
                            title="{{localize 'CINEMATIC.Config.SaveActorTitle'}}">
                            <i class="fas fa-user"></i> {{localize "CINEMATIC.Config.BtnSavePersonalPreset"}}
                        </button>

                        <button type="button" data-action="save-to-global" style="width: auto; color: #4ecdc4;"
                            title="{{localize 'CINEMATIC.Config.SaveGlobalTitle'}}">
                            <i class="fas fa-globe"></i> {{localize "CINEMATIC.Config.BtnSaveGlobalPreset"}}
                        </button>

                        {{else}}
                        
                        <!-- ★ [Case B & C] 글로벌/씬 모드 -->
                        
                        <!-- 씬 모드일 때만 '글로벌로 내보내기' 버튼 표시 -->
                        {{#if isSceneMode}}
                        <button type="button" data-action="save-to-global" style="width: auto; color: #4ecdc4;"
                            title="{{localize 'CINEMATIC.Config.SaveGlobalTitle'}}">
                            <i class="fas fa-globe"></i> {{localize "CINEMATIC.Config.Btn.Global"}}
                        </button>
                        {{/if}}

                        <!-- 저장 안내 문구 (공통) -->
                        <div style="flex:0 0 auto; display:flex; align-items:center; padding:0 10px; color:#888; font-size:0.8em;">
                            <i class="fas fa-info-circle"></i> &nbsp; {{localize "CINEMATIC.Config.Hint.SaveBottom"}}
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>

            {{#if isGlobalMode}}
            <div style="background: rgba(0,0,0,0.2); padding: 10px; border-radius: 5px; margin-bottom: 15px; border: 1px solid #444;">
                <h4 style="margin-top: 0;">{{localize "CINEMATIC.Config.Groups.Title"}}</h4>

                {{#each actorGroups}}
                <div style="display:flex; gap:6px; align-items:center; margin-bottom:6px;">
                    <input type="text" name="groupName.{{this.id}}" value="{{this.name}}" placeholder="{{localize 'CINEMATIC.Config.Groups.Name'}}" style="flex:1;" />
                    <select name="groupDefault.{{this.id}}" style="flex:1;">
                        <option value="">{{localize "CINEMATIC.Config.Groups.NoDefault"}}</option>
                        {{#each ../globalPresets}}
                        <option value="{{this.id}}" {{#if (eq this.id ../defaultPresetId)}}selected{{/if}}>{{this.name}}</option>
                        {{/each}}
                    </select>
                    <button type="button" data-action="remove-actor-group" data-group-id="{{this.id}}" style="flex:0 0 32px; color:#ff6b6b;">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                {{/each}}

                <button type="button" data-action="add-actor-group" style="width:auto; margin-top:4px;">
                    <i class="fas fa-plus"></i> {{localize "CINEMATIC.Config.Groups.Add"}}
                </button>
                <p class="hint" style="margin-top:8px;">{{localize "CINEMATIC.Config.Groups.Hint"}}</p>
            </div>
            {{/if}}

            {{#if isActorMode}}
            <div class="form-group" style="margin-bottom: 10px; display:block;">
                <label style="display:block; margin-bottom:4px;">{{localize "CINEMATIC.Config.Label.ActorGroup"}}</label>
                <div class="form-fields" style="width:100%;">
                    <select name="groupId" style="width:100%;">
                        <option value="">{{localize "CINEMATIC.Config.Option.NoGroup"}}</option>
                        {{#each actorGroups}}
                        <option value="{{this.id}}" data-group-name="{{this.name}}" data-default-preset="{{this.defaultPresetName}}" data-has-triggers="{{this.hasInheritedTriggers}}" {{#if this.selected}}selected{{/if}}>{{this.name}}{{#if this.defaultPresetName}} ({{this.defaultPresetName}}){{/if}}</option>
                        {{/each}}
                    </select>
                </div>
                <p class="hint" style="margin:4px 0 0 0; display:block;">{{localize "CINEMATIC.Config.Hint.ActorGroup"}}</p>
                <p id="actor-group-fallback-hint" class="hint" style="margin:2px 0 0 0; color:#7fd1b9; display:{{#if hasActorGroupDefaultFallback}}block{{else}}none{{/if}};">{{actorGroupFallbackHint}}</p>
                <label style="display:flex; align-items:center; gap:6px; margin-top:6px; font-size:0.85em; color:#ccc;">
                    <input type="checkbox" name="inheritGroupTriggers" {{checked inheritGroupTriggers}}>
                    <span>{{localize "CINEMATIC.Config.Label.InheritGroupTriggers"}}</span>
                </label>
                <p class="hint" style="margin:2px 0 0 0; display:block;">{{localize "CINEMATIC.Config.Hint.InheritGroupTriggers"}}</p>
            </div>
            {{/if}}
        </div>

        <!-- ============================================ -->
        <!-- TAB: VISUAL -->
        <!-- ============================================ -->
        <div class="tab-content" data-tab="visual">
            {{#if supportsActorContext}}
            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.ImageSource"}}</label>
                <div class="form-fields" style="display:flex; flex-direction:column; align-items:stretch;">
                    <select name="characterImageSource">
                        <option value="preset" {{#if (eq characterImageSource "preset")}}selected{{/if}}>
                            {{localize "CINEMATIC.Config.Option.PresetImage"}}
                        </option>
                        <option value="actor" {{#if (eq characterImageSource "actor")}}selected{{/if}}>
                            {{localize "CINEMATIC.Config.Option.CurrentActorImage"}}
                        </option>
                    </select>
                </div>
            </div>
            {{/if}}

            <div class="form-group character-image-path {{#if useActorImage}}is-actor-image-source{{/if}}"
                data-actor-image-preview="{{actorImagePreview}}">
                <label>{{localize "CINEMATIC.Config.Label.Image"}}</label>
                <div class="form-fields character-image-picker">
                    <file-picker name="img" type="imagevideo" value="{{img}}"></file-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.Theme"}}</label>
                <div class="form-fields">
                    <select name="theme">
                        {{#each themeOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
                            {{localize this.label}}
                        </option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CustomDuration"}}</label>
                <div class="form-fields">
                    <input type="range" name="customDuration" min="1.5" max="8.0" step="0.5" value="{{customDuration}}">
                    <span class="range-value" style="width: 40px; text-align: right;">{{customDuration}}s</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.Format"}}</label>
                <div class="form-fields">
                    <select name="format">
                        <option value="popout" {{#if (eq format "popout" )}}selected{{/if}}>{{localize
                            "CINEMATIC.Format.Popout"}}</option>
                        <option value="boxed" {{#if (eq format "boxed" )}}selected{{/if}}>{{localize
                            "CINEMATIC.Format.Boxed"}}</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.HideBackground"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="hideBackground" {{checked hideBackground}}>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.HideCharacter"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="hideCharacter" {{checked hideCharacter}}>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.Loop"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="videoLoop" {{checked videoLoop}}>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.ScreenPos"}}</label>
                <div class="form-fields" style="display: flex; gap: 10px;">
                    <!-- X축 (0% = 왼쪽, 100% = 오른쪽) -->
                    <div class="mini-field" title="Horizontal (X)">
                        <label>X</label>
                        <input type="range" name="screenPosX" min="0" max="100" step="1" value="{{screenPosX}}">
                        <span class="range-value">{{screenPosX}}%</span>
                    </div>

                    <!-- Y축 (0% = 위, 100% = 아래) -->
                    <div class="mini-field" title="Vertical (Y)">
                        <label>Y</label>
                        <input type="range" name="screenPos" min="0" max="90" step="1" value="{{screenPos}}">
                        <span class="range-value">{{screenPos}}%</span>
                    </div>
                </div>
            </div>

            <!-- [1] 캐릭터 조정 섹션 수정 -->
            <div class="form-group adjust-row">
                <label>{{localize "CINEMATIC.Config.Label.CharAdjust"}}</label>
                
                <!-- 그리드 레이아웃을 확장하여 Angle / Mirror 추가 -->
                <div class="form-fields grid-layout" style="grid-template-columns: repeat(5, 1fr);">
                    
                    <div class="mini-field">
                        <span class="sub-label">{{localize "CINEMATIC.Config.Label.Scale"}}</span>
                        <input type="number" name="charScale" value="{{charScale}}" min="0.1" max="20.0" step="0.1">
                    </div>
                    <div class="mini-field">
                        <span class="sub-label">{{localize "CINEMATIC.Config.Label.PosX"}}</span>
                        <input type="number" name="charOffsetX" value="{{charOffsetX}}">
                    </div>
                    <div class="mini-field">
                        <span class="sub-label">{{localize "CINEMATIC.Config.Label.PosY"}}</span>
                        <input type="number" name="charOffsetY" value="{{charOffsetY}}">
                    </div>
                    
                    <!-- ★ [추가] 회전 (Angle) -->
                    <div class="mini-field">
                        <span class="sub-label">{{localize "CINEMATIC.Config.Short.Angle"}}</span>
                        <input type="number" name="charRotation" value="{{charRotation}}" step="5" placeholder="0°">
                    </div>

                    <!-- ★ [추가] 반전 (Mirror) -->
                    <div class="mini-field" title="{{localize 'CINEMATIC.Config.Label.Mirror'}}">
                        <span class="sub-label"><i class="fas fa-exchange-alt"></i></span>
                        <input type="checkbox" name="charMirror" {{checked charMirror}}>
                    </div>
                </div>
            </div>

            <div class="form-group"
                style="display:block; margin-top:15px; background:rgba(0,0,0,0.2); padding:10px; border-radius:4px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
                    <label style="font-weight:bold;">{{localize "CINEMATIC.Config.Variations"}}</label>
                    <button type="button" data-action="add-variation"
                        style="width:auto; padding:2px 10px; font-size:0.8em;color:white;">
                        <i class="fas fa-plus"></i> {{localize "CINEMATIC.Config.BtnAddVariation"}}
                    </button>
                </div>
                <p style="font-size:0.8em; color:#888; margin-bottom:10px;">{{localize "CINEMATIC.Config.TipVariation"}}
                </p>

                <div class="variation-list" style="display:flex; flex-direction:column; gap:5px;">
                    {{#each variations}}
                    <div class="variation-row"
                        style="display:flex; align-items:center; gap:5px; background:rgba(255,255,255,0.05); padding:5px; border-radius:3px;">

                        <!-- 1. 이미지 (썸네일) -->
                        <div style="flex:0 0 40px; height:40px; position:relative;">
                            <img src="{{this.img}}"
                                style="width:100%; height:100%; object-fit:cover; border:1px solid #444;">
                            <input type="hidden" name="variations.{{@index}}.img" value="{{this.img}}">
                            <button type="button" data-action="browse-variation-img" data-index="{{@index}}"
                                style="position:absolute; inset:0; opacity:0; cursor:pointer; width:100%; height:100%; border:none; padding:0; margin:0;">
                            </button>
                        </div>

                        <!-- 2. 좌표/스케일 그리드 -->
                        <div style="flex:0 0 120px; display:grid; grid-template-columns: 1fr 1fr 1fr; gap:2px;">
                            <div class="mini-field">
                                <label style="font-size:0.7em; color:#aaa;">S</label>
                                <input type="number" name="variations.{{@index}}.charScale" value="{{this.charScale}}"
                                    step="0.1" title="Scale">
                            </div>
                            <div class="mini-field">
                                <label style="font-size:0.7em; color:#aaa;">X</label>
                                <input type="number" name="variations.{{@index}}.charOffsetX"
                                    value="{{this.charOffsetX}}" step="1" title="Offset X">
                            </div>
                            <div class="mini-field">
                                <label style="font-size:0.7em; color:#aaa;">Y</label>
                                <input type="number" name="variations.{{@index}}.charOffsetY"
                                    value="{{this.charOffsetY}}" step="1" title="Offset Y">
                            </div>
                        </div>

                        <!-- 3. 텍스트 오버라이드 -->
                        <div style="flex:1; display:flex; flex-direction:column; gap:2px;">
                            <input type="text" name="variations.{{@index}}.text" value="{{this.text}}"
                                placeholder="Main Text (Opt)"
                                style="font-size:0.8em; height:18px; background:rgba(0,0,0,0.3); border:none; padding:0 5px; color:#fff;">

                            <input type="text" name="variations.{{@index}}.subText" value="{{this.subText}}"
                                placeholder="Sub Text (Opt)"
                                style="font-size:0.8em; height:18px; background:rgba(0,0,0,0.3); border:none; padding:0 5px; color:#ccc;">
                        </div>

                        <!-- 4. 삭제 버튼 -->
                        <button type="button" data-action="remove-variation" data-index="{{@index}}"
                            style="flex:0 0 25px; height:25px; color:#ff6b6b; background:transparent; border:none;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: TEXT -->
        <!-- ============================================ -->
        <div class="tab-content" data-tab="text">
            <input type="hidden" name="textOffsetMode" value="{{textOffsetMode}}">

            {{#if isLegacyTextOffset}}
            <div class="form-group text-offset-upgrade">
                <label>{{localize "CINEMATIC.Config.Label.TextOffsetMode"}}</label>
                <div class="form-fields">
                    <span class="text-offset-upgrade-hint">{{localize "CINEMATIC.Config.Hint.LegacyTextOffset"}}</span>
                    <button type="button" data-action="convert-text-offsets" title="{{localize 'CINEMATIC.Config.Hint.ConvertTextOffsets'}}">
                        <i class="fas fa-arrows-alt"></i> {{localize "CINEMATIC.Config.BtnConvertTextOffsets"}}
                    </button>
                </div>
            </div>
            {{/if}}

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.MainText"}}</label>
                <div class="form-fields">
                    <input type="text" name="text" value="{{text}}" style="flex:1;">

                    {{#if supportsActorContext}}
                    <button type="button" data-action="insert-actor-name" class="actor-name-placeholder-button"
                        title="{{localize 'CINEMATIC.Config.Hint.ActorNamePlaceholder'}}">
                        <i class="fas fa-user-tag"></i> {{localize "CINEMATIC.Config.BtnInsertActorName"}}
                    </button>
                    {{/if}}
                    
                    <!-- ★ [추가] Main Text 숨김 체크박스 -->
                    <div class="mini-field" style="width:30px;" title="{{localize 'CINEMATIC.Config.Label.Hide'}}">
                        <label><i class="fas fa-eye-slash"></i></label>
                        <input type="checkbox" name="hideMainText" {{checked hideMainText}}>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.PreserveMainTextCase"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="preserveMainTextCase" {{checked preserveMainTextCase}}>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.MainSize"}}</label>
                <div class="form-fields">
                    <input type="range" name="mainFontSize" min="4" max="15" step="0.5" value="{{mainFontSize}}">
                    <span class="range-value">{{mainFontSize}}rem</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.MainOffset"}}</label>
                <div class="form-fields">
                    <input type="number" name="mainOffsetX" value="{{mainOffsetX}}"
                        placeholder="{{localize 'CINEMATIC.Config.Placeholder.X'}}" style="width: 60px;">
                    <input type="number" name="mainOffsetY" value="{{mainOffsetY}}"
                        placeholder="{{localize 'CINEMATIC.Config.Placeholder.Y'}}" style="width: 60px;">
                    <span style="font-size:0.8em; color:#888;">(px)</span>
                </div>
            </div>

            <!-- Sub Text 설정 -->
            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.SubText"}}</label>
                <div class="form-fields">
                    <input type="text" name="subText" value="{{subText}}" style="flex:1;">
                    
                    <!-- ★ [추가] Sub Text 숨김 체크박스 -->
                    <div class="mini-field" style="width:30px;" title="{{localize 'CINEMATIC.Config.Label.Hide'}}">
                        <label><i class="fas fa-eye-slash"></i></label>
                        <input type="checkbox" name="hideSubText" {{checked hideSubText}}>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.SubSize"}}</label>
                <div class="form-fields">
                    <input type="range" name="subFontSize" min="1" max="5" step="0.1" value="{{subFontSize}}">
                    <span class="range-value">{{subFontSize}}rem</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.SubOffset"}}</label>
                <div class="form-fields">
                    <input type="number" name="subOffsetX" value="{{subOffsetX}}"
                        placeholder="{{localize 'CINEMATIC.Config.Placeholder.X'}}" style="width: 60px;">
                    <input type="number" name="subOffsetY" value="{{subOffsetY}}"
                        placeholder="{{localize 'CINEMATIC.Config.Placeholder.Y'}}" style="width: 60px;">
                    <span style="font-size:0.8em; color:#888;">(px)</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.FontFamily"}}</label>
                <div class="form-fields">
                    <select name="fontFamily" style="font-family: '{{fontFamily}}';"
                        onchange="this.style.fontFamily = this.value">
                        {{#each fontList}}
                        <option value="{{this.id}}" style="font-family: '{{this.id}}';" {{#if (eq ../fontFamily
                            this.id)}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <label class="font-toggle {{#if fontBold}}active{{/if}}" title="{{localize 'CINEMATIC.Config.Label.FontBold'}}">
                        <input type="checkbox" name="fontBold" {{checked fontBold}}>
                        <span>B</span>
                    </label>
                    <label class="font-toggle font-toggle-italic {{#if fontItalic}}active{{/if}}" title="{{localize 'CINEMATIC.Config.Label.FontItalic'}}">
                        <input type="checkbox" name="fontItalic" {{checked fontItalic}}>
                        <span>I</span>
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.SubFontFamily"}}</label>
                <div class="form-fields">
                    <select name="subFontFamily" style="font-family: '{{subFontFamily}}';"
                        onchange="this.style.fontFamily = this.value">
                        {{#each fontList}}
                        <option value="{{this.id}}" style="font-family: '{{this.id}}';" {{#if (eq ../subFontFamily
                            this.id)}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <label class="font-toggle {{#if subFontBold}}active{{/if}}" title="{{localize 'CINEMATIC.Config.Label.FontBold'}}">
                        <input type="checkbox" name="subFontBold" {{checked subFontBold}}>
                        <span>B</span>
                    </label>
                    <label class="font-toggle font-toggle-italic {{#if subFontItalic}}active{{/if}}" title="{{localize 'CINEMATIC.Config.Label.FontItalic'}}">
                        <input type="checkbox" name="subFontItalic" {{checked subFontItalic}}>
                        <span>I</span>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.TextColor"}}</label>
                <div class="form-fields">
                    <div class="mini-field" style="flex:1; background:transparent;">
                        <span class="sub-label" style="margin-bottom:2px;">{{localize
                            "CINEMATIC.Config.Label.Main"}}</span>
                        <color-picker name="mainTextColor" value="{{mainTextColor}}"></color-picker>
                    </div>
                    <div class="mini-field" style="flex:1; background:transparent;">
                        <span class="sub-label" style="margin-bottom:2px;">{{localize
                            "CINEMATIC.Config.Label.Sub"}}</span>
                        <color-picker name="subTextColor" value="{{subTextColor}}"></color-picker>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: EFFECTS -->
        <!-- ============================================ -->
        <div class="tab-content" data-tab="effects">
            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.ThemeColor"}}</label>
                <div class="form-fields">
                    <color-picker name="color" value="{{color}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.Border"}}</label>
                <div class="form-fields">
                    <input type="number" name="borderWidth" value="{{borderWidth}}" min="0" max="10"
                        placeholder="{{localize 'CINEMATIC.Config.Placeholder.Width'}}">
                    <color-picker name="borderColor" value="{{borderColor}}"></color-picker>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CharShadow"}}</label>
                <div class="form-fields">
                    <color-picker name="charShadowColor" value="{{charShadowColor}}"></color-picker>
                    <label style="display:flex;align-items:center;gap:4px;margin-left:8px;white-space:nowrap;">
                        <input type="checkbox" name="hideCharShadow" {{checked hideCharShadow}}>
                        {{localize "CINEMATIC.Config.Label.HideCharShadow"}}
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.Shake"}}</label>
                <div class="form-fields">
                    <input type="range" name="shakeIntensity" min="0" max="10" step="1" value="{{shakeIntensity}}">
                    <span class="range-value">{{shakeIntensity}}</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.DimIntensity"}}</label>
                <div class="form-fields">
                    <input type="range" name="dimIntensity" min="0" max="100" step="1" value="{{dimIntensity}}">
                    <span class="range-value">{{dimIntensity}}%</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.ScreenMood"}}</label>
                <div class="form-fields">
                    <select name="screenMood">
                        {{#each screenMoodOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
                            {{localize this.label}}
                        </option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.ScreenMoodOpacity"}}</label>
                <div class="form-fields">
                    <input type="range" name="screenMoodOpacity" min="0" max="100" step="1" value="{{screenMoodOpacity}}">
                    <span class="range-value">{{screenMoodOpacity}}%</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CinematicEffect"}}</label>
                <div class="form-fields">
                    <select name="cinematicEffect">
                        <option value="{{cinematicEffectNoneOption.id}}" {{#if cinematicEffectNoneOption.selected}}selected{{/if}}>
                            {{localize cinematicEffectNoneOption.label}}
                        </option>
                        {{#each cinematicEffectGroups}}
                        <optgroup label="{{localize this.label}}">
                            {{#each this.options}}
                            <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
                                {{localize this.label}}
                            </option>
                            {{/each}}
                        </optgroup>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CinematicEffectStrength"}}</label>
                <div class="form-fields">
                    <select name="cinematicEffectStrength">
                        {{#each cinematicEffectStrengthOptions}}
                        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>
                            {{localize this.label}}
                        </option>
                        {{/each}}
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CinematicEffectPositionX"}}</label>
                <div class="form-fields">
                    <input type="range" name="cinematicEffectOffsetX" min="-100" max="100" step="1" value="{{cinematicEffectOffsetX}}">
                    <span class="range-value">{{cinematicEffectOffsetX}}%</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CinematicEffectPositionY"}}</label>
                <div class="form-fields">
                    <input type="range" name="cinematicEffectOffsetY" min="-100" max="100" step="1" value="{{cinematicEffectOffsetY}}">
                    <span class="range-value">{{cinematicEffectOffsetY}}%</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.CinematicEffectScale"}}</label>
                <div class="form-fields">
                    <input type="range" name="cinematicEffectScale" min="25" max="300" step="1" value="{{cinematicEffectScale}}">
                    <span class="range-value">{{cinematicEffectScale}}%</span>
                </div>
            </div>

            <div class="form-group"
                style="display:block; margin-top:10px; background:rgba(0,0,0,0.2); padding:8px; border-radius:4px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
                    <label style="font-weight:bold;">{{localize "CINEMATIC.Config.Label.SoundList"}}</label>
                    <button type="button" data-action="add-sound-path" data-type="sound"
                        style="width:auto; padding:2px 8px; font-size:0.8em;">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>

                <div style="display:flex; flex-direction:column; gap:3px;">
                    {{#each soundList}}
                    <div class="sound-row" style="display:flex; gap:5px; align-items:center;">
                        <input type="text" name="soundList.{{@index}}" value="{{this}}" placeholder="path/to/audio.ogg"
                            style="flex:1;">
                        <button type="button" data-action="browse-audio" data-target="soundList.{{@index}}"
                            style="flex:0 0 30px;" title="Browse">
                            <i class="fas fa-music"></i>
                        </button>
                        <button type="button" data-action="remove-sound-path" data-type="sound" data-index="{{@index}}"
                            style="flex:0 0 30px; color:#ff6b6b;" title="Remove">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="form-group"
                style="display:block; margin-top:10px; background:rgba(0,0,0,0.2); padding:8px; border-radius:4px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px;">
                    <label style="font-weight:bold;">{{localize "CINEMATIC.Config.Label.SFXList"}}</label>
                    <button type="button" data-action="add-sound-path" data-type="sfx"
                        style="width:auto; padding:2px 8px; font-size:0.8em;">
                        <i class="fas fa-plus"></i>
                    </button>
                </div>

                <div style="display:flex; flex-direction:column; gap:3px;">
                    {{#each sfxList}}
                    <div class="sound-row" style="display:flex; gap:5px; align-items:center;">
                        <input type="text" name="sfxList.{{@index}}" value="{{this}}" placeholder="path/to/effect.ogg"
                            style="flex:1;">
                        <button type="button" data-action="browse-audio" data-target="sfxList.{{@index}}"
                            style="flex:0 0 30px;" title="Browse">
                            <i class="fas fa-music"></i>
                        </button>
                        <button type="button" data-action="remove-sound-path" data-type="sfx" data-index="{{@index}}"
                            style="flex:0 0 30px; color:#ff6b6b;" title="Remove">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="form-group" style="margin-top:10px;">
                <label>{{localize "CINEMATIC.Config.Label.SoundVolume"}}</label>
                <div class="form-fields">
                    <input type="range" name="soundVolume" min="0" max="100" step="1" value="{{soundVolume}}">
                    <span class="range-value">{{soundVolume}}%</span>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.SFXVolume"}}</label>
                <div class="form-fields">
                    <input type="range" name="sfxVolume" min="0" max="100" step="1" value="{{sfxVolume}}">
                    <span class="range-value">{{sfxVolume}}%</span>
                </div>
            </div>

            <div class="form-group" style="margin-top:10px;">
                <label class="checkbox">
                    <input type="checkbox" name="keepAudioPlaying" {{checked keepAudioPlaying}}>
                    {{localize "CINEMATIC.Config.Label.KeepAudioPlaying"}}
                </label>
            </div>

            <div class="form-group" style="margin-top:10px;">
                <label class="checkbox">
                    <input type="checkbox" name="audioOnly" {{checked audioOnly}}>
                    {{localize "CINEMATIC.Config.Label.AudioOnly"}}
                </label>
                <p class="hint" style="margin:0; font-size:0.8em; color:#888;">{{localize "CINEMATIC.Config.Hint.AudioOnly"}}</p>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.LocalOnly"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="localOnly" {{checked localOnly}}>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "CINEMATIC.Config.Label.VideoAudio"}}</label>
                <div class="form-fields">
                    <input type="checkbox" name="videoAudio" {{checked videoAudio}}>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: LAYERS -->
        <!-- ============================================ -->
        <div class="tab-content" data-tab="layers">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                <h3 style="margin:0;"><i class="fas fa-layer-group"></i> {{localize "CINEMATIC.Config.LayerManager"}}
                </h3>
                <button type="button" data-action="add-layer"
                    style="width:auto; padding:5px 10px; font-size:0.8em; background:#333;">
                    <i class="fas fa-plus"></i> {{localize "CINEMATIC.Config.Layer.BtnAdd"}}
                </button>
            </div>

            <!-- 레이어 리스트 (Z-Index 순서대로 정렬되어 표시됨) -->
            <div class="layer-list-container" style="display:flex; flex-direction:column; gap:5px;">
                
                {{#each uiLayers}}
                    <!-- [A] 시스템 고정 요소 (캐릭터, 텍스트 등) - 수정 불가, 위치 확인용 -->
                    {{#if this.isSystem}}
                    <div class="system-layer-guide" 
                         style="background: rgba(255, 255, 255, 0.1); padding: 8px; border-radius: 4px; border: 1px dashed #666; display: flex; align-items: center; justify-content: space-between; opacity: 0.8;">
                        <span style="font-weight:bold; color:#ccc; font-size:0.9em;">
                            <i class="fas fa-lock"></i> [Z: {{this.z}}] {{this.label}}
                        </span>
                        <span style="font-size:0.8em; color:#888;">{{localize "CINEMATIC.Config.Layer.SystemFixed"}}</span>
                    </div>

                    <!-- [B] 사용자 커스텀 레이어 -->
                    {{else}}
                    <div class="layer-row"
                        style="background:rgba(0,0,0,0.3); padding:8px; border-radius:5px; border:1px solid #444; display:flex; flex-direction:column; gap:5px; border-left: 4px solid #e61c34;">

                        <!-- 1줄: 썸네일 + Z-Index + 파일 선택 + 삭제 -->
                        <div style="display:flex; gap:5px; align-items:center;">
                            
                            <!-- 썸네일 미리보기 박스 -->
                            <div class="layer-thumb-container" 
                                style="width:40px; height:40px; background:#000; border:1px solid #555; border-radius:3px; overflow:hidden; display:flex; align-items:center; justify-content:center; flex:0 0 40px;">
                                {{#if this.data.src}}
                                    {{#if this.isVideo}}
                                        <video src="{{this.data.src}}" autoplay loop muted style="width:100%; height:100%; object-fit:cover;"></video>
                                    {{else}}
                                        <img src="{{this.data.src}}" style="width:100%; height:100%; object-fit:cover;">
                                    {{/if}}
                                {{else}}
                                    <i class="fas fa-image" style="color:#555;"></i>
                                {{/if}}
                            </div>

                            <!-- Z-Index 입력 -->
                            <div class="mini-field" style="width:50px; height:40px; background:#444; justify-content: space-between; padding: 2px;" title="{{localize 'CINEMATIC.Config.Layer.ZIndexHint'}}">
                                <label style="color:#e61c34; font-weight:bold; font-size:0.7em;">Z-Idx</label>
                                <input type="number" name="layers.{{this.originalIndex}}.zIndex" value="{{this.data.zIndex}}" step="1" 
                                    style="color:#fff; font-weight:bold; height:20px; font-size:1em;">
                            </div>

                            <file-picker name="layers.{{this.originalIndex}}.src" type="imagevideo" value="{{this.data.src}}"
                                style="flex:1; height: 40px;"></file-picker>

                            <button type="button" data-action="remove-layer" data-index="{{this.originalIndex}}"
                                style="width:30px; height:40px; color:#ff6b6b;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <!-- 2줄: 상세 속성 -->
                        <div style="display:flex; gap:5px; align-items:center; flex-wrap:wrap;">
                            
                            <!-- Blend Mode -->
                            <select name="layers.{{this.originalIndex}}.blend" style="width:80px; font-size:0.8em; background:#222;"
                                title="{{localize 'CINEMATIC.Config.Label.BlendMode'}}">
                                <option value="normal" {{#if (eq this.data.blend "normal" )}}selected{{/if}}>{{localize "CINEMATIC.Blend.Normal"}}</option>
                                <option value="screen" {{#if (eq this.data.blend "screen" )}}selected{{/if}}>{{localize "CINEMATIC.Blend.Screen"}}</option>
                                <option value="multiply" {{#if (eq this.data.blend "multiply" )}}selected{{/if}}>{{localize "CINEMATIC.Blend.Multiply"}}</option>
                                <option value="overlay" {{#if (eq this.data.blend "overlay" )}}selected{{/if}}>{{localize "CINEMATIC.Blend.Overlay"}}</option>
                                <option value="add" {{#if (eq this.data.blend "add" )}}selected{{/if}}>{{localize "CINEMATIC.Blend.Add"}}</option>
                            </select>

                            <div class="mini-field" style="width:35px;" title="{{localize 'CINEMATIC.Config.Label.Opacity'}}">
                                <label>{{localize "CINEMATIC.Config.Short.Opacity"}}</label>
                                <input type="number" name="layers.{{this.originalIndex}}.opacity" value="{{this.data.opacity}}" step="0.1"
                                    min="0" max="1">
                            </div>

                            <div class="mini-field" style="width:35px;" title="{{localize 'CINEMATIC.Config.Label.Scale'}}">
                                <label>{{localize "CINEMATIC.Config.Short.Scale"}}</label>
                                <input type="number" name="layers.{{this.originalIndex}}.scale" value="{{this.data.scale}}" step="0.1">
                            </div>

                            <div class="mini-field" style="width:35px;" title="{{localize 'CINEMATIC.Config.Label.PosX'}}">
                                <label>{{localize "CINEMATIC.Config.Short.X"}}</label>
                                <input type="number" name="layers.{{this.originalIndex}}.x" value="{{this.data.x}}" step="10">
                            </div>
                            <div class="mini-field" style="width:35px;" title="{{localize 'CINEMATIC.Config.Label.PosY'}}">
                                <label>{{localize "CINEMATIC.Config.Short.Y"}}</label>
                                <input type="number" name="layers.{{this.originalIndex}}.y" value="{{this.data.y}}" step="10">
                            </div>

                            <div class="mini-field" style="width:35px;" title="{{localize 'CINEMATIC.Config.Label.Rotation'}}">
                                <label>Rot</label>
                                <input type="number" name="layers.{{this.originalIndex}}.rotation" value="{{this.data.rotation}}" step="45">
                            </div>

                            <div class="mini-field" style="width:20px;" title="{{localize 'CINEMATIC.Config.Label.Mirror'}}">
                                <label><i class="fas fa-exchange-alt"></i></label>
                                <input type="checkbox" name="layers.{{this.originalIndex}}.mirror" {{checked this.data.mirror}}>
                            </div>

                            <div class="mini-field" style="width:20px;" title="{{localize 'CINEMATIC.Config.Label.Loop'}}">
                                <label><i class="fas fa-sync"></i></label>
                                <input type="checkbox" name="layers.{{this.originalIndex}}.loop" {{checked this.data.loop}}>
                            </div>

                            <div class="mini-field" style="width:20px;" title="{{localize 'CINEMATIC.Config.Label.VideoAudio'}}">
                                <label><i class="fas fa-volume-up"></i></label>
                                <input type="checkbox" name="layers.{{this.originalIndex}}.videoAudio" {{checked this.data.videoAudio}}>
                            </div>

                            <div class="mini-field" style="width:45px;" title="{{localize 'CINEMATIC.Config.Label.LayerDelay'}}">
                                <label>{{localize "CINEMATIC.Config.Short.Delay"}}</label>
                                <input type="number" name="layers.{{this.originalIndex}}.delay" value="{{this.data.delay}}" step="0.1" min="0" placeholder="0">
                            </div>
                        </div>
                        <!-- 3줄: 마스킹 (Masking) 옵션 -->
                        <div style="display:flex; gap:5px; align-items:center; border-top:1px dashed #555; padding-top:4px; margin-top:2px;">
                            <label style="font-size:0.8em; color:#e67e22; font-weight:bold;">
                                <i class="fas fa-mask"></i> Mask:
                            </label>

                            <!-- 1. 마스크 모드 선택 -->
                            <select name="layers.{{this.originalIndex}}.maskMode" 
                                    style="width:70px; font-size:0.8em; background:#222; color:#fff;"
                                    class="mask-mode-select">
                                <option value="none" {{#if (eq this.data.maskMode "none")}}selected{{/if}}>None</option>
                                <option value="banner" {{#if (eq this.data.maskMode "banner")}}selected{{/if}}>Banner ⚠</option>
                                <option value="shape" {{#if (eq this.data.maskMode "shape")}}selected{{/if}}>Shape</option>
                                <option value="image" {{#if (eq this.data.maskMode "image")}}selected{{/if}}>Image</option>
                            </select>
                            <span class="banner-warning" style="display: {{#if (eq this.data.maskMode 'banner')}}inline{{else}}none{{/if}}; color:#f90; font-size:0.7em; margin-left:2px;" title="Some themes (Blitz, Slash, Brush, etc.) apply skew/rotate transforms. Banner-masked layers may appear tilted in these themes.">⚠</span>

                            <!-- 2. [Shape 전용] 모양 선택 -->
                            <select name="layers.{{this.originalIndex}}.maskShape" 
                                    style="flex:1; font-size:0.8em; background:#222; color:#ccc; display: {{#if (eq this.data.maskMode 'shape')}}block{{else}}none{{/if}};"
                                    class="mask-input-shape">
                                <!-- 움직이는 3대장 -->
                                <option value="circle" {{#if (eq this.data.maskShape "circle")}}selected{{/if}}>● Circle</option>
                                <option value="ellipse" {{#if (eq this.data.maskShape "ellipse")}}selected{{/if}}>⬭ Oval</option>
                                <option value="inset" {{#if (eq this.data.maskShape "inset")}}selected{{/if}}>◼ Square</option>
                            </select>

                            <!-- 3. [Image 전용] 파일 선택 -->
                            <div class="mask-input-image" style="flex:1; display: {{#if (eq this.data.maskMode 'image')}}block{{else}}none{{/if}};">
                                <file-picker name="layers.{{this.originalIndex}}.maskSrc" type="image" value="{{this.data.maskSrc}}" 
                                            style="width:100%; height:24px; font-size:0.8em;"></file-picker>
                            </div>

                            <!-- 4. [공통] 크기/위치 조절 (None이 아닐 때만 보임) -->
                            <div class="mask-input-dims" style="display: {{#if (eq this.data.maskMode 'none')}}none{{else}}flex{{/if}}; gap:1px;">
                                <input type="number" name="layers.{{this.originalIndex}}.maskSize" value="{{this.data.maskSize}}" 
                                    placeholder="S%" title="Size (%)"
                                    style="width:35px; height:24px; font-size:0.8em; text-align:center; padding:0; background:#333; border:1px solid #555; color:#fff;">
                                
                                <input type="number" name="layers.{{this.originalIndex}}.maskX" value="{{this.data.maskX}}" 
                                    placeholder="X%" title="Pos X (%)"
                                    style="width:35px; height:24px; font-size:0.8em; text-align:center; padding:0; background:#333; border:1px solid #555; color:#fff;">
                                    
                                <input type="number" name="layers.{{this.originalIndex}}.maskY" value="{{this.data.maskY}}" 
                                    placeholder="Y%" title="Pos Y (%)"
                                    style="width:35px; height:24px; font-size:0.8em; text-align:center; padding:0; background:#333; border:1px solid #555; color:#fff;">
                            </div>
                        </div>
                    </div>
                    {{/if}}
                {{/each}}

                {{#unless layers.length}}
                <div style="text-align:center; color:#666; font-size:0.9em; padding:10px;">
                    {{localize "CINEMATIC.Config.Layer.EmptyState"}}
                </div>
                {{/unless}}
            </div>
        </div>

        <!-- ============================================ -->
        <!-- TAB: TRIGGERS -->
        <!-- ============================================ -->
        <div class="tab-content" data-tab="triggers">
            <h3><i class="fas fa-exclamation-circle"></i> {{localize "CINEMATIC.Config.Tab.Triggers"}}</h3>

            {{#if isActorMode}}
            <div style="background: rgba(78, 205, 196, 0.1); border: 1px solid rgba(78, 205, 196, 0.45); color: #b9f4ef; padding: 8px 10px; border-radius: 4px; margin-bottom: 12px; font-size: 0.85em;">
                <i class="fas fa-info-circle"></i> {{localize "CINEMATIC.Trigger.Hint.PresetSources"}}
            </div>
            <div id="trigger-group-fallback-hint" style="display:{{#if hasActorGroupDefaultFallback}}block{{else}}none{{/if}}; background: rgba(127, 209, 185, 0.12); border: 1px solid #4db49a; color: #b6f2e3; padding: 8px 10px; border-radius: 4px; margin-bottom: 12px; font-size: 0.85em;">
                <i class="fas fa-link"></i> <span>{{actorGroupFallbackHint}}</span>
            </div>
            <div id="trigger-group-inheritance-hint" style="display:{{#if hasActorGroupInheritedTriggers}}block{{else}}none{{/if}}; background: rgba(127, 209, 185, 0.12); border: 1px solid #4db49a; color: #b6f2e3; padding: 8px 10px; border-radius: 4px; margin-bottom: 12px; font-size: 0.85em;">
