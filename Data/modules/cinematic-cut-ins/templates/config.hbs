                    <span>{{localize "CINEMATIC.Trigger.Column.Detail"}}</span>
                    <span>{{localize "CINEMATIC.Trigger.Column.Preset"}}</span>
                    <span style="color:#b8860b;">{{localize "CINEMATIC.Trigger.MacroLabel"}}</span>
                    <span></span>
