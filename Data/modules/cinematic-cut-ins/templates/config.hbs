                        <option value="onDamage" {{#if (eq this.trigger "onDamage" )}}selected{{/if}}
                            style="color:#3498db; font-weight:bold;">{{localize "CINEMATIC.Trigger.Type.OnDamage"}}</option>
                        <option value="onCrit" {{#if (eq this.trigger "onCrit" )}}selected{{/if}}
                            style="color:#e74c3c; font-weight:bold;">{{localize "CINEMATIC.Trigger.Type.OnCritical"}}</option>
