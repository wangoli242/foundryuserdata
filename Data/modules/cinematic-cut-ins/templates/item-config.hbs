<div class="cinematic-config-wrapper" style="padding: 10px; display: flex; flex-direction: column; gap: 10px; height: 100%;">
    
    <!-- 아이템 이름 헤더 -->
    <div style="background: rgba(255,255,255,0.05); padding: 10px; border-radius: 5px; text-align: center;">
        <h3 style="margin: 0; font-family: 'Teko'; font-size: 1.5em; border: none;">
            <i class="fas fa-box-open"></i> {{itemName}}
        </h3>
    </div>

    <!-- 상세 가이드 박스 추가 -->
    {{{localize "CINEMATIC.ItemConfig.Hint"}}}

    <!-- 컬럼 설명 헤더 -->
    <div style="display:grid; grid-template-columns: 1.3fr 1.8fr 1fr 1fr 30px; gap:5px; font-size:0.8em; color:#888; padding:0 5px;">
        <span>Condition</span>
        <span>Detail (Text / Dice)</span>
        <span>Play Preset</span>
        <span style="color:#b8860b;">{{localize "CINEMATIC.Trigger.MacroLabel"}}</span>
        <span></span>
    </div>

    <!-- 트리거 리스트 영역 -->
    <div class="trigger-list" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 5px;">
        {{#each triggers}}
        <div class="trigger-row" style="display: grid; grid-template-columns: 1.3fr 1.8fr 1fr 1fr 30px; gap: 5px; align-items: center; background: #222; padding: 5px; border: 1px solid #444; border-radius: 4px;">
            
            <!-- 1. 트리거 타입 선택 -->
            <select name="triggers.{{@index}}.trigger" style="width: 100%; font-size:0.85em;" class="trigger-type-select">
                {{#each ../triggerTypes}}
                <option value="{{this.value}}" {{#if (eq ../this.trigger this.value)}}selected{{/if}}>
                    {{this.label}}
                </option>
                {{/each}}
            </select>

            <!-- 2. 조건값 입력 영역 (JavaScript로 교체됨) -->
            <div class="condition-inputs" style="width:100%; display:flex; align-items:center;">
                
                <!-- A. 일반 입력 (Keyword) -->
                <!-- 평소에는 이 input이 보입니다. -->
                <input type="text" name="triggers.{{@index}}.value" value="{{this.value}}" 
                    class="input-general"
                    style="width: 100%; font-size:0.9em; text-align:center; background:rgba(0,0,0,0.3);">

                <!-- B. 주사위 상세 입력 (Dice Check) -->
                <!-- Dice Check 선택 시 A는 숨겨지고 이 div가 보입니다. -->
                <div class="input-dice-detail" style="display:none; width:100%; gap:2px;">
                    
                    <!-- 선택적 키워드 입력창 -->
                    <!-- diceKeyword라는 임시 이름 사용 -->
                    <input type="text" name="triggers.{{@index}}.diceKeyword" value="{{this.diceKeyword}}" 
                        placeholder="Opt. Keyword" title="Optional Text Condition"
                        style="width: 80px; font-size:0.8em; text-align:center; background:rgba(0,0,0,0.3); border:1px solid #555; color:#fff;">

                    <!-- 순서 -->
                    <input type="number" name="triggers.{{@index}}.rollIndex" value="{{this.rollIndex}}" 
                        placeholder="#" title="Roll Index (0=1st)"
                        style="width: 30px; text-align:center; font-size:0.8em; background:rgba(0,0,0,0.3); border:1px solid #555; color:#fff;">
                    
                    <!-- 연산자 -->
                    <select name="triggers.{{@index}}.operator" style="width: 45px; font-size:0.8em; padding:0; background:#222; color:#fff;">
                        <option value=">=" {{#if (eq this.operator ">=")}}selected{{/if}}>&ge;</option>
                        <option value="<=" {{#if (eq this.operator "<=")}}selected{{/if}}>&le;</option>
                        <option value="==" {{#if (eq this.operator "==")}}selected{{/if}}>=</option>
                    </select>

                    <!-- 값 -->
                    <input type="number" name="triggers.{{@index}}.diceValue" value="{{this.diceValue}}" 
                        class="input-dice-val"
                        placeholder="Val" 
                        style="flex:1; text-align:center; background:rgba(0,0,0,0.3); border:1px solid #555; color:#fff;">
                </div>
            </div>

            <!-- 3. 프리셋 선택 -->
            <select name="triggers.{{@index}}.presetId" style="width: 100%; font-size:0.85em;">
                <option value="">-- Select --</option>
                {{#each ../presets}}
                <option value="{{this.id}}" {{#if (eq ../this.presetId this.id)}}selected{{/if}}>
                    {{this.name}}
                </option>
                {{/each}}
            </select>

            <!-- 4. 매크로 선택 -->
            <select name="triggers.{{@index}}.macroId" style="width: 100%; font-size:0.8em; color:#b8860b; background:rgba(0,0,0,0.3); border:1px solid #555;" title="{{localize 'CINEMATIC.Trigger.MacroTooltip'}}">
                <option value="">{{localize "CINEMATIC.Trigger.NoMacro"}}</option>
                {{#each ../macroList}}
                <option value="{{this.id}}" {{#if (eq ../this.macroId this.id)}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>

            <!-- 5. 삭제 버튼 -->
            <button type="button" data-action="removeTrigger" data-index="{{@index}}"
                style="height: 28px; background: #442222; color: #ff6b6b; border: 1px solid #ff4444; padding:0; display:flex; align-items:center; justify-content:center;">
                <i class="fas fa-times"></i>
            </button>
        </div>
        {{/each}}

        {{#unless triggers.length}}
        <div style="text-align: center; color: #666; padding: 20px; border: 2px dashed #333;">
            No rules yet.<br>Click 'Add Rule' to configure.
        </div>
        {{/unless}}
    </div>

    <!-- 하단 버튼 -->
    <div class="actions" style="border-top: 1px solid #444; padding-top: 10px; display: flex; gap: 10px;">
        <button type="button" data-action="addTrigger" style="background: #333; color: #ccc;">
            <i class="fas fa-plus"></i> Add Rule
        </button>
        <button type="button" data-action="save" style="background: #e61c34; color: #fff;">
            <i class="fas fa-save"></i> Save Settings
        </button>
    </div>
</div>